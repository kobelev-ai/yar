# Plaud Transcript Fetcher Configuration
# Copy this file to .env and fill in your values

# IMAP Server (your email provider)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Email credentials
# For Gmail: use App Password (not your regular password)
# https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Where to save transcripts (absolute path)
MEETINGS_INBOX=/path/to/your/workspace/inbox

# Preserved transcript originals (absolute path; optional when workspace root is known)
MEETINGS_PROCESSED=/path/to/your/workspace/ops/meetings/processed

# How often to check (seconds)
CHECK_INTERVAL=300

# Email subject prefix for Plaud transcripts
PLAUD_SUBJECT_PREFIX=[Plaud-AutoFlow]
